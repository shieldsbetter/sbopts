{
    "name": "@shieldsbetter/sbopts",
    "version": "0.1.0",
    "description": "Opinionated ESM command-line parser: --long/-s flags, boolean stacking, repeated-as-array values, inherited subcommand flags, and termiflo-rendered --help.",
    "homepage": "https://github.com/shieldsbetter/sbopts#readme",
    "bugs": "https://github.com/shieldsbetter/sbopts/issues",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/shieldsbetter/sbopts.git"
    },
    "author": "Hampton Smith <1743291+hamptonsmith@users.noreply.github.com>",
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.d.ts",
            "default": "./src/index.js"
        },
        "./package.json": "./package.json"
    },
    "types": "./src/index.d.ts",
    "files": [
        "src",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "test": "node --test",
        "coverage": "c8 --100 --reporter=text --reporter=json-summary npm test",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc -p tsconfig.json",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepublishOnly": "npm run lint && npm run typecheck && npm run format:check && npm run coverage"
    },
    "keywords": [
        "cli",
        "argv",
        "args",
        "arguments",
        "option-parser",
        "options",
        "flags",
        "getopt",
        "subcommands",
        "command-line"
    ],
    "license": "ISC",
    "sideEffects": false,
    "dependencies": {
        "@shieldsbetter/termiflo": "^0.1.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "badge-maker": "^6.0.0",
        "c8": "^12.0.0",
        "eslint": "^10.5.0",
        "eslint-plugin-perfectionist": "^5.10.1",
        "globals": "^17.6.0",
        "prettier": "^3.8.4",
        "typescript": "^6.0.3"
    }
}
