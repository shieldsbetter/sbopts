{
    "compilerOptions": {
        "strict": true,
        "noEmit": true,
        "target": "es2022",
        "lib": ["es2022"],
        "module": "node16",
        "moduleResolution": "node16",
        // Deliberately OFF. With skipLibCheck on, an error inside index.d.ts is
        // only reported where a test happens to touch it, so most of the file
        // would go unchecked.
        "skipLibCheck": false
    },
    "files": ["src/index.d.ts", "test-d/index.test-d.ts"]
}
